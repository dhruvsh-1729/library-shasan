SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURSO_URL=
TURSO_AUTH_TOKEN=

# Maileroo Email API. Sender address/name are defined in lib/download-email.ts.
MAILEROO_API_KEY=

# Optional SMTP fallback if MAILEROO_API_KEY is not set.
MAILEROO_SMTP_HOST=smtp.maileroo.com
MAILEROO_SMTP_PORT=587
MAILEROO_SMTP_USERNAME=
MAILEROO_SMTP_PASSWORD=

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The full public origin of the deployment, e.g. https://library.aryanculture.org
NEXTAUTH_URL=

# Google OAuth (optional). When unset, only email/password sign-in is offered.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
