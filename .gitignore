# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local pipeline scratch output
/.library_pipeline_output
/.library_pipeline_state
/.tmp
/.tmp_benchmark
/.tmp_library_pipeline
/.tmp_ocr500
/results.json

# railway
/.railway

# sarvam pipeline state and logs
/.sarvam
